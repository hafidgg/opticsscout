// Prisma schema — Product Discovery & Comparison Platform
// See DATA_MODEL.md for design rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum SeoStatus {
  DRAFT
  REVIEW
  READY
  INDEXABLE
  NOINDEX
  ARCHIVED
}

enum AffiliateNetwork {
  AMAZON
  EBAY
  ETSY
  AWIN
  AVANTLINK
  IMPACT
  CJ
  ENVATO
  GUMROAD
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
  DISCONTINUED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

// ---------- Core taxonomy ----------

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToSubcategory")

  products    Product[]
  guides      Guide[]
  comparisons Comparison[]
  bestPages   BestPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ---------- Product / Offer / Merchant ----------

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  brand            String?
  description      String?
  shortDescription String?

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  images         String[]
  specifications Json?
  features       String[]
  pros           String[]
  cons           String[]

  whoItsFor       String?
  whoShouldAvoid  String?
  verdict         String?

  // Never fabricated — nullable until a real, sourced value exists (Section 37).
  rating      Float?
  reviewCount Int?

  // SEO — first-class fields, not bolted on (Section 12/14).
  seoStatus       SeoStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  canonicalPath   String?

  offers        ProductOffer[]
  sourceRecords SourceRecord[]
  clickEvents   ClickEvent[]

  comparisonEntries ComparisonProduct[]
  guideEntries      GuideProduct[]
  bestPageEntries   BestPageProduct[]

  // Self-relation for "alternatives" (Section 6: /alternatives/[slug])
  alternativeOf   Product[] @relation("ProductAlternatives")
  alternatives    Product[] @relation("ProductAlternatives")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([seoStatus])
}

model Merchant {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  website          String
  affiliateNetwork AffiliateNetwork
  affiliateProgram String?
  active           Boolean          @default(true)

  offers      ProductOffer[]
  clickEvents ClickEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateNetwork])
}

model ProductOffer {
  id        String @id @default(cuid())
  productId String
  merchantId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Canonical destination URL — no affiliate tracking params (Section 32).
  url String

  // Generated by the affiliate service, stored for audit/debugging (Section 17).
  affiliateUrl String?

  price    Decimal? @db.Decimal(10, 2)
  currency String   @default("USD")
  // True when `price` is a manufacturer's suggested retail price rather than a
  // live, merchant-verified price — the UI must label this distinctly (never
  // presented as this merchant's current price). See NOTES_DEPENDENCIES.md.
  isMsrp   Boolean  @default(false)

  availability AvailabilityStatus @default(UNKNOWN)
  lastChecked  DateTime?

  // Per-offer visibility toggle — independent of Merchant.active (an account-level
  // switch) and of `availability` (a stock-status signal). This is what lets a real
  // row be staged for a merchant/network application that hasn't been approved yet
  // (see docs/AFFILIATE_MARKETING.md): insert the row with active: false so nothing
  // public ever renders or redirects to it, then flip to true once approved with a
  // real URL. Defaults true so existing/normal offers are unaffected.
  active Boolean @default(true)

  // Campaign/placement metadata only — no PII (Section 18).
  trackingMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, merchantId])
  @@index([merchantId])
  @@index([productId, active])
}

// ---------- Editorial content ----------

model Comparison {
  id     String @id @default(cuid())
  slug   String @unique
  title  String
  verdict String?

  // Used to scope duplicate/cannibalizing-intent detection to same-category
  // comparisons (SEO_STRATEGY.md §5) — not a display field.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  products ComparisonProduct[]

  seoStatus       SeoStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  canonicalPath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seoStatus])
  @@index([categoryId])
}

// Explicit join table — preserves display order of products within a comparison.
model ComparisonProduct {
  comparisonId String
  productId    String
  position     Int

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([comparisonId, productId])
  @@index([productId])
}

model Guide {
  id     String  @id @default(cuid())
  slug   String  @unique
  title  String
  intent String? // the search intent this page targets, e.g. "best standing desk for small apartments"
  content String? // long-form editorial body

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  products GuideProduct[]

  seoStatus       SeoStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  canonicalPath   String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([categoryId])
  @@index([seoStatus])
}

model GuideProduct {
  guideId   String
  productId String
  position  Int

  guide   Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([guideId, productId])
  @@index([productId])
}

// "/best/[slug]" pages (SEO_STRATEGY.md §2) — a ranked pick list with a verdict,
// not necessarily long-form narrative content. Kept as its own model rather than
// reusing Guide so the two can diverge in shape (master brief §13).
model BestPage {
  id      String  @id @default(cuid())
  slug    String  @unique
  title   String
  intent  String?
  verdict String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  products BestPageProduct[]

  seoStatus       SeoStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  canonicalPath   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([seoStatus])
}

model BestPageProduct {
  bestPageId String
  productId  String
  position   Int // ordered — top pick first

  bestPage BestPage @relation(fields: [bestPageId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bestPageId, productId])
  @@index([productId])
}

// ---------- Provenance ----------

model SourceRecord {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  source      String          // e.g. "manufacturer spec sheet", "merchant listing"
  sourceUrl   String?
  retrievedAt DateTime
  field       String          // which Product field this supports, e.g. "weightCapacityKg"
  value       String
  confidence  ConfidenceLevel

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([field])
}

// ---------- Tracking ----------

model ClickEvent {
  id         String @id @default(cuid())
  productId  String
  merchantId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  page      String // path of the page the click originated from
  placement String // e.g. "product-hero-cta", "comparison-table-row"
  sessionId String // anonymous, not tied to any user identity — no PII

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([merchantId])
  @@index([createdAt])
}
